# Raw/intermediate/generated data; retain placeholder files
/data/raw/*
!/data/raw/.gitkeep
/data/mock/*
!/data/mock/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated models, predictions, and reports
/outputs/models/*
