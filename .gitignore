/outputs/predictions/*
!/outputs/predictions/.gitkeep
/outputs/reports/*
!/outputs/reports/.gitkeep
*.joblib
*.pkl
*.log

# Workbook and Power BI local exports
/workbook/*.xlsx
/workbook/*.xlsm
/dashboard/*.pbix
